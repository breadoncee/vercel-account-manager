#!/bin/sh
# Named account profiles for the Vercel CLI.

set -eu
umask 077

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
if [ -n "${VCM_HOME:-}" ]; then
  state_dir=$VCM_HOME
elif [ -n "${VERCEL_ACCOUNT_MANAGER_HOME:-}" ]; then
  state_dir=$VERCEL_ACCOUNT_MANAGER_HOME
elif [ -n "${VCA_STATE_DIR:-}" ]; then
  state_dir=$VCA_STATE_DIR
elif [ -d "$config_home/vercel-account-switcher" ]; then
  state_dir=$config_home/vercel-account-switcher
elif [ -d "$config_home/vercel-account-manager" ]; then
  state_dir=$config_home/vercel-account-manager
else
  state_dir=$config_home/vcm
fi
profiles_dir=$state_dir/profiles
active_file=$state_dir/active

usage() {
  cat <<'EOF'
Usage:
  vcm add NAME [--default | CONFIG_DIR]  Add an account and make it the global default
  vcm rename OLD_NAME NEW_NAME            Rename a saved account label
  vcm account remove NAME                 Unregister an account label
  vcm use NAME [TEAM]                    Set account/team for the current project
  vcm use --global NAME [TEAM]           Set the global default account/team
  vcm default [NAME [TEAM]]              Show or set the global default account/team
  vcm team [TEAM]                        Set the team for the current context
  vcm team --global [TEAM]               Set the global default account's team
  vcm teams                              List teams for the effective account
  vcm current [--global]                 Show the effective or global account
  vcm status [--global]                  Show account, team, and config source
  vcm list                               List registered accounts
  vcm login [NAME]                       Refresh an account's login
  vcm VERCEL_ARGS...                     Run a Vercel CLI command

Examples:
  vcm add personal --default             Keep your existing Vercel login
  vcm add work                           Log in once and save the work account
  vcm rename work client                  Rename work without logging in again
  vcm account remove client               Unregister client from vcm
  vcm default personal                    Quickly select the global default
  vcm use --global personal              Set the fallback account
  vcm use work my-team                   Pin this project to work/my-team
  vcm status                             See which config is in effect
  vcm deploy                             Run Vercel with that account/team

For an already saved custom login, use its exact config directory:
  vcm add work "$HOME/.config/vercel-work"
EOF
}

die() {
  printf 'vcm: %s\n' "$*" >&2
  exit 1
}

valid_name() {
  case $1 in
    ''|*[!a-zA-Z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

profile_path() {
  valid_name "$1" || die "invalid account name: $1"
  printf '%s/%s\n' "$profiles_dir" "$1"
}

read_profile() {
  profile_file=$(profile_path "$1")
  [ -f "$profile_file" ] || die "unknown account '$1'; run 'vcm list'"
  IFS= read -r config_dir < "$profile_file" || die "cannot read account '$1'"
  [ -n "$config_dir" ] || die "empty config for account '$1'"
}

selected_global_account() {
  [ -f "$active_file" ] || die "no global account selected; run 'vcm add NAME' or 'vcm use --global NAME'"
  IFS= read -r account < "$active_file" || die 'cannot read selected account'
  read_profile "$account"
}

valid_team() {
  case $1 in
    ''|*[!a-zA-Z0-9_.-]*) return 1 ;;
    *) return 0 ;;
  esac
}

find_project_file() {
  project_file=
  search_dir=$(pwd -P)
  while :; do
    if [ -f "$search_dir/.vcmrc" ]; then
      project_file=$search_dir/.vcmrc
      return 0
    fi
    [ "$search_dir" != / ] || return 0
    search_dir=${search_dir%/*}
    [ -n "$search_dir" ] || search_dir=/
  done
}

read_project_file() {
  project_account=
  project_team=
  seen_account=0
  seen_team=0
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      ''|\#*) ;;
      account=*)
        [ "$seen_account" -eq 0 ] || die "duplicate account in $project_file"
        project_account=${line#account=}
        seen_account=1
        ;;
      team=*)
        [ "$seen_team" -eq 0 ] || die "duplicate team in $project_file"
        project_team=${line#team=}
        seen_team=1
        ;;
      *) die "invalid line in $project_file: $line" ;;
    esac
  done < "$project_file"
  [ "$seen_account" -eq 1 ] && valid_name "$project_account" || die "invalid account in $project_file"
  [ -z "$project_team" ] || valid_team "$project_team" || die "invalid team in $project_file"
}

resolve_context() {
  find_project_file
  if [ -n "$project_file" ]; then
    read_project_file
    account=$project_account
    team=$project_team
    context_source=$project_file
    read_profile "$account"
  else
    selected_global_account
    team=
    context_source=global
  fi
}

write_project_file() {
  target_file=$1
  target_account=$2
  target_team=$3
  temp_file=$target_file.tmp.$$
  printf 'account=%s\nteam=%s\n' "$target_account" "$target_team" > "$temp_file"
  mv "$temp_file" "$target_file"
}

invoke_vercel() {
  if [ "$config_dir" = :default: ]; then
    vercel "$@"
  else
    vercel --global-config "$config_dir" "$@"
  fi
}

run_vercel() {
  if [ -n "${team:-}" ]; then
    for option do
      case $option in
        --scope|--scope=*|-S|--team|--team=*|-T) team=; break ;;
      esac
    done
  fi
  if [ "$config_dir" = :default: ]; then
    if [ -n "${team:-}" ]; then
      exec vercel --scope "$team" "$@"
    else
      exec vercel "$@"
    fi
  else
    if [ -n "${team:-}" ]; then
      exec vercel --global-config "$config_dir" --scope "$team" "$@"
    else
      exec vercel --global-config "$config_dir" "$@"
    fi
  fi
}

select_account() {
  mkdir -p "$state_dir"
  printf '%s\n' "$1" > "$active_file"
  printf 'Global default account: %s.\n' "$1"
}

set_global_account() {
  name=$1
  target_team=${2:-}
  read_profile "$name"
  if [ -n "$target_team" ]; then
    valid_team "$target_team" || die "invalid team: $target_team"
    invoke_vercel switch "$target_team"
  fi
  select_account "$name"
}

case ${1:-} in
  add)
    [ "$#" -ge 2 ] && [ "$#" -le 3 ] || die 'usage: vcm add NAME [--default | CONFIG_DIR]'
    name=$2
    profile_file=$(profile_path "$name")
    [ ! -e "$profile_file" ] || die "account '$name' already exists"
    mkdir -p "$profiles_dir"
    case ${3:-} in
      --default) config_dir=:default: ;;
      '') config_dir=$state_dir/auth/$name; mkdir -p "$config_dir" ;;
      /*) config_dir=$3; [ -d "$config_dir" ] || die "config directory does not exist: $config_dir" ;;
      *) die 'CONFIG_DIR must be an absolute path' ;;
    esac
    printf '%s\n' "$config_dir" > "$profile_file"
    printf 'Added %s.\n' "$name"
    if [ "$#" -eq 2 ]; then
      printf 'Complete the one-time Vercel login for %s.\n' "$name"
      if ! invoke_vercel login; then
        printf "vcm: login was not completed; retry with 'vcm login %s'.\n" "$name" >&2
        exit 1
      fi
    fi
    select_account "$name"
    ;;
  rename)
    [ "$#" -eq 3 ] || die 'usage: vcm rename OLD_NAME NEW_NAME'
    old_name=$2
    new_name=$3
    old_profile=$(profile_path "$old_name")
    new_profile=$(profile_path "$new_name")
    [ -f "$old_profile" ] || die "unknown account '$old_name'; run 'vcm list'"
    [ ! -e "$new_profile" ] && [ ! -L "$new_profile" ] || die "account '$new_name' already exists"
    find_project_file
    if [ -n "$project_file" ]; then
      read_project_file
    fi
    mv "$old_profile" "$new_profile"
    if [ -f "$active_file" ]; then
      IFS= read -r current < "$active_file" || die 'cannot read selected account'
      if [ "$current" = "$old_name" ]; then
        temp_file=$active_file.tmp.$$
        printf '%s\n' "$new_name" > "$temp_file"
        mv "$temp_file" "$active_file"
      fi
    fi
    if [ -n "$project_file" ] && [ "$project_account" = "$old_name" ]; then
      write_project_file "$project_file" "$new_name" "$project_team"
    fi
    printf 'Renamed %s to %s.\n' "$old_name" "$new_name"
    ;;
  account)
    [ "$#" -eq 3 ] && [ "$2" = remove ] || die 'usage: vcm account remove NAME'
    name=$3
    profile_file=$(profile_path "$name")
    [ -f "$profile_file" ] || die "unknown account '$name'; run 'vcm list'"
    was_active=0
    if [ -f "$active_file" ]; then
      IFS= read -r current < "$active_file" || die 'cannot read selected account'
      [ "$current" != "$name" ] || was_active=1
    fi
    rm "$profile_file"
    if [ "$was_active" -eq 1 ]; then
      rm "$active_file"
    fi
    printf 'Removed %s from vcm.\n' "$name"
    if [ "$was_active" -eq 1 ]; then
      printf "No global default selected. Run 'vcm default NAME' to choose another.\n"
    fi
    printf 'Vercel login files were kept. Update any .vcmrc files that use this name.\n'
    ;;
  login)
    [ "$#" -le 2 ] || die 'usage: vcm login [NAME]'
    if [ "$#" -eq 2 ]; then
      read_profile "$2"
    else
      resolve_context
    fi
    invoke_vercel login
    ;;
  use)
    if [ "${2:-}" = --global ]; then
      [ "$#" -ge 3 ] && [ "$#" -le 4 ] || die 'usage: vcm use --global NAME [TEAM]'
      set_global_account "$3" "${4:-}"
    else
      [ "$#" -ge 2 ] && [ "$#" -le 3 ] || die 'usage: vcm use NAME [TEAM]'
      name=$2
      target_team=${3:-}
      read_profile "$name"
      [ -z "$target_team" ] || valid_team "$target_team" || die "invalid team: $target_team"
      project_file=$(pwd -P)/.vcmrc
      write_project_file "$project_file" "$name" "$target_team"
      printf 'Project config: %s\n' "$project_file"
    fi
    ;;
  default)
    [ "$#" -le 3 ] || die 'usage: vcm default [NAME [TEAM]]'
    if [ "$#" -eq 1 ]; then
      selected_global_account
      printf '%s\n' "$account"
    else
      set_global_account "$2" "${3:-}"
    fi
    ;;
  list)
    [ "$#" -eq 1 ] || die 'usage: vcm list'
    if [ ! -d "$profiles_dir" ]; then
      printf 'No accounts registered. Run: vcm add NAME\n'
      exit 0
    fi
    current=
    if [ -f "$active_file" ]; then
      IFS= read -r current < "$active_file" || true
    fi
    found=0
    for file in "$profiles_dir"/*; do
      [ -f "$file" ] || continue
      found=1
      name=${file##*/}
      IFS= read -r dir < "$file" || die "cannot read account '$name'"
      [ "$dir" != :default: ] || dir='existing Vercel login'
      marker=' '
      [ "$name" != "$current" ] || marker='*'
      printf '%s %-16s %s\n' "$marker" "$name" "$dir"
    done
    [ "$found" -ne 0 ] || printf 'No accounts registered. Run: vcm add NAME\n'
    ;;
  current)
    [ "$#" -le 2 ] || die 'usage: vcm current [--global]'
    if [ "$#" -eq 2 ]; then
      [ "$2" = --global ] || die 'usage: vcm current [--global]'
      selected_global_account
    else
      resolve_context
    fi
    printf '%s\n' "$account"
    ;;
  status)
    [ "$#" -le 2 ] || die 'usage: vcm status [--global]'
    if [ "$#" -eq 2 ]; then
      [ "$2" = --global ] || die 'usage: vcm status [--global]'
      selected_global_account
      team=
      context_source=global
    else
      resolve_context
    fi
    printf 'Account: %s\n' "$account"
    if [ -n "$team" ]; then
      printf 'Team: %s\n' "$team"
    else
      printf 'Team: Vercel CLI default for this account\n'
    fi
    printf 'Source: %s\n' "$context_source"
    ;;
  teams)
    [ "$#" -eq 1 ] || die 'usage: vcm teams'
    resolve_context
    invoke_vercel teams list
    ;;
  team)
    if [ "${2:-}" = --global ]; then
      [ "$#" -le 3 ] || die 'usage: vcm team --global [TEAM]'
      selected_global_account
      project_file=
      target_team=${3:-}
    else
      [ "$#" -le 2 ] || die 'usage: vcm team [TEAM]'
      resolve_context
      target_team=${2:-}
    fi
    if [ -n "$project_file" ]; then
      if [ -z "$target_team" ]; then
        [ -t 0 ] || die 'usage: vcm team TEAM (interactive choice requires a terminal)'
        invoke_vercel teams list
        printf 'Team slug: ' >&2
        IFS= read -r target_team || die 'team selection canceled'
      fi
      valid_team "$target_team" || die "invalid team: $target_team"
      write_project_file "$project_file" "$account" "$target_team"
      printf 'Project team: %s (%s)\n' "$target_team" "$project_file"
    elif [ -n "$target_team" ]; then
      valid_team "$target_team" || die "invalid team: $target_team"
      invoke_vercel switch "$target_team"
    else
      invoke_vercel switch
    fi
    ;;
  help|--help|-h|'')
    usage
    ;;
  --)
    shift
    [ "$#" -gt 0 ] || die 'missing Vercel command after --'
    resolve_context
    run_vercel "$@"
    ;;
  *)
    resolve_context
    run_vercel "$@"
    ;;
esac
